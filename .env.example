# Copy to .env and adjust. .env is gitignored: no real credential should ever
# reach the repository, even a demo one, because the habit is what matters.
#
# In production these values come from the platform's secret store (GitHub
# Actions secrets for CI, and SOPS/age or the provider's secret manager on the
# host) - see docs/DECISIONS.md for the full reasoning.

# --- edge ---
HTTP_PORT=8080
HTTPS_PORT=8443

# --- observability ---
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
# Change this before exposing the stack anywhere beyond localhost.
GRAFANA_ADMIN_PASSWORD=admin

# --- service tuning ---
MAX_SESSIONS=5000
# Demo-only: synthetic latency spread and fault injection, so the dashboards
# have a distribution and an error rate worth looking at. Set both to 0 to see
# the service's real behaviour.
PROCESSING_JITTER=25ms
ERROR_INJECTION_RATE=0.02

# --- load generator ---
LOAD_CONNECTIONS=25
LOAD_RATE=5
LOAD_DURATION=0s

# --- image identity ---
# The deploy pipeline rewrites ECHO_IMAGE to a digest-pinned reference, so the
# host runs exactly the bytes that were tested rather than whatever a tag
# currently points at.
ECHO_IMAGE=realtime-edge-demo/echo-service:local
LOADGEN_IMAGE=realtime-edge-demo/loadgen:local
VERSION=dev
