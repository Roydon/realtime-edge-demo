# NOTE: this file is a template. The container entrypoint substitutes
# ${DNS_RESOLVER} and writes the result to /etc/nginx/conf.d/default.conf.
# Nothing else in it is templated - every other $variable is an nginx runtime
# variable and is passed through untouched.

# Edge configuration for the demo stack.
#
# This file is mounted into /etc/nginx/conf.d/ and is therefore evaluated
# inside the http{} block, which is why the zone and log_format definitions
# below are valid here. The base image's own nginx.conf is left untouched, so
# an image upgrade does not silently revert defaults this stack depends on.

# A log line per request with the timings needed to tell "the upstream is slow"
# apart from "the client is slow" during an incident. The default combined
# format has neither, which is exactly the information missing at 3am.
log_format edge_json escape=json '{'
    '"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$uri",'
    '"status":$status,'
    '"bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_connect_time":"$upstream_connect_time",'
    '"upstream_response_time":"$upstream_response_time",'
    '"upgrade":"$http_upgrade"'
'}';

# Rate limits are sized for a demo, not for production. They exist to show
# where the control lives; the real numbers come from measured traffic.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=session_limit:10m;

# The WebSocket upgrade dance: proxying a connection requires passing through
# the Upgrade header, and HTTP/1.1 with Connection set accordingly. Mapping it
# rather than hard-coding "upgrade" means plain HTTP requests on the same
# server block are not broken by a stray Connection header.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Upstreams are resolved at request time, not at config load.
#
# This matters more than it looks. nginx resolves a hostname in an `upstream`
# block exactly once, when the configuration is loaded, and caches the address
# forever. Every deploy that replaces the service container gives it a new
# address, and nginx keeps sending traffic to the old one - returning "no live
# upstreams" and 502ing every request until someone reloads nginx by hand.
# On a voice platform that is every call dropped, on every release, until a
# human notices.
#
# Pointing `resolver` at the container DNS and passing the upstream through a
# variable forces re-resolution on the `valid` interval instead. The cost is
# that a variable in proxy_pass bypasses the `upstream` block, so connection
# keepalive to the backend is lost: an extra TCP handshake per request on the
# internal network. That is a real cost and it is worth paying, because the
# alternative fails closed on exactly the operation that happens most often.
#
# The resolver address is substituted at container start from the container's
# own /etc/resolv.conf, because it is not the same everywhere: Docker uses
# 127.0.0.11, Podman uses the network gateway, and a VM uses whatever the host
# resolver is. Hardcoding any one of them means the config silently works on
# the author's machine and 502s on someone else's.
resolver ${DNS_RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

server {
    listen 8080;
    server_name _;

    access_log /var/log/nginx/access.log edge_json;

    # Everything except the ACME path is redirected. In this demo the
    # certificate is self-signed so the well-known path is unused, but the
    # shape is kept so a real deployment only has to point it at a webroot.
    location /.well-known/acme-challenge/ {
        return 404;
    }

    location / {
        return 301 https://$host:8443$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    access_log /var/log/nginx/access.log edge_json;

    ssl_certificate     /etc/nginx/certs/edge.crt;
    ssl_certificate_key /etc/nginx/certs/edge.key;

    # TLS 1.2 is retained because SIP gateways and older mobile SDKs in this
    # space still negotiate it; 1.0/1.1 are not offered at all.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    # Session resumption cuts a full handshake off reconnects, which matters
    # when clients reconnect after a network blip mid-call.
    ssl_session_cache   shared:TLS:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # HSTS is intentionally commented out for the demo: with a self-signed
    # certificate it would pin browsers to a cert they cannot validate. It is
    # the first thing to enable once a real certificate is in place.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Do not advertise the exact nginx version to the internet.
    server_tokens off;

    location /ws {
        limit_conn session_limit 100;

        set $echo_upstream echo-service:8080;
        proxy_pass http://$echo_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The default 60s read timeout would sever any session idle for a
        # minute, which for a long-lived signalling connection means dropping
        # healthy users. Application-level idle handling owns this instead.
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_connect_timeout 5s;

        # Buffering a stream defeats the point of streaming it.
        proxy_buffering off;
    }

    location /api/ {
        limit_req zone=api_limit burst=100 nodelay;

        set $echo_upstream echo-service:8080;
        proxy_pass http://$echo_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout   30s;
    }

    location = /healthz {
        set $echo_upstream echo-service:8080;
        proxy_pass http://$echo_upstream/healthz;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    # Grafana is served through the edge rather than published on its own host
    # port, so there is exactly one TLS-terminating entry point to secure and
    # to reason about. Prometheus deliberately is not - see docs/DECISIONS.md.
    location /grafana/ {
        set $grafana_upstream grafana:3000;
        # The prefix is stripped here rather than with a trailing slash on
        # proxy_pass, because a proxy_pass carrying a variable and a URI would
        # send that literal URI for every request instead of the real one.
        rewrite ^/grafana/(.*)$ /$1 break;
        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Grafana Live pushes dashboard updates over a WebSocket.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # The service's /metrics endpoint is not proxied. Scraping happens on the
    # internal network; exposing it at the edge would publish internal
    # topology and cardinality to anyone who asks.
    location /metrics {
        return 404;
    }
}

# stub_status for the Prometheus exporter, on a separate listener bound inside
# the container network only. It is never reachable from a published port.
server {
    listen 8090;
    server_name _;

    location = /stub_status {
        stub_status;
        access_log off;
    }
}
