# Volume snapshots produced by `make backup`.
backups/

# Build output.
/bin/
/dist/
demo-output/

# Terraform: state can contain secrets in plaintext, and the provider plugin
# directory is large and machine-specific.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
crash.log

# OS and editor noise.
.DS_Store
*.swp
